import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

class ErrorFeedbackSystem {
    public String getErrorMessage(String issueType) {
        if (issueType == null) {
            return "";
        }
        switch (issueType) {
            case "PREREQUISITE_MISSING":
                return "Error: Prerequisite course is missing. Complete the required prerequisite before registering.";
            case "COURSE_FULL":
                return "Error: Selected course section is full. Choose another available section or waitlist.";
            case "SCHEDULE_CONFLICT":
                return "Error: Schedule conflict detected with an existing registered section. Select a non-overlapping time.";
            case "CREDIT_LIMIT_EXCEEDED":
                return "Error: Maximum credit hours limit exceeded. Drop a course or reduce credits before registering.";
            case "DUPLICATE_SECTION":
                return "Error: Duplicate section attempt. You are already registered or submitted this section.";
            default:
                return "Error: Registration cannot be completed.";
        }
    }
}

