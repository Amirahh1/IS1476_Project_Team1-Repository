class RegistrationSystem {
    public boolean canRepeatCourse(String courseCode, String previousGrade) {
        if (previousGrade == null || previousGrade.equalsIgnoreCase("F")) {
            return true;
        }
        switch (previousGrade.toUpperCase()) {
            case "A":
            case "B+":
            case "B":
            case "C+":
            case "C":
                return false;
            case "D+":
            case "D":
                return true;
            default:
                return false;
        }
    }
}

